{
  "expo": {
    "name": "Mis Finanzas",
    "newArchEnabled": true,
    "slug": "finanzas-app",
    "version": "2.6.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "finanzas",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tufinanzas.app",
      "buildNumber": "2",
      "infoPlist": {
        "UIStatusBarHidden": false,
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "package": "com.tufinanzas.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Mis Finanzas necesita acceso al microfono para que dictes tus movimientos por voz.",
          "speechRecognitionPermission": "Mis Finanzas usa el reconocimiento de voz para convertir tu dictado en texto.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f1b045a3-3d8f-41bc-86a7-3cf019868e93"
      }
    },
    "owner": "pedromercadodev"
  }
}
